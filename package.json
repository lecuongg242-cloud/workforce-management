{
  "name": "timeflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "node --env-file=.env.local scripts/db.mjs push",
    "db:seed": "node --env-file=.env.local scripts/db.mjs seed",
    "test:rls": "node --env-file=.env.local scripts/db.mjs test",
    "test:db": "node --env-file=.env.local scripts/db.mjs testdb",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "test": "vitest run",
    "check:assertions": "node scripts/check-pgtap-assertions.mjs",
    "seed:auth": "node --env-file=.env.local scripts/seed-auth.mjs",
    "reset:passwords": "node --env-file=.env.local scripts/reset-temp-passwords.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
