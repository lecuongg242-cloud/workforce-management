# Hop dong bien moi truong cho TimeFlow. File nay duoc commit va KHONG duoc
# chua bat ky gia tri that nao — chi ten bien + chu thich lay o dau.
# Sao chep thanh .env.local (da nam trong .gitignore) va dien gia tri that.

# Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Dashboard -> Project Settings -> API Keys -> Publishable key (sb_publishable_...)
# Khong bao gio doi ten bien nay sang tien to NEXT_PUBLIC_ — no van an toan de dua
# xuong client vi chi co quyen theo RLS, nhung giu nguyen quy uoc doc server-side.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# Chi dung o server (Server Action / Route Handler), khong bao gio dua xuong client.
SUPABASE_SECRET_KEY=

# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# (che do "Direct connection" / non-pooling), dung cho psql va cac lenh migrate.
POSTGRES_URL_NON_POOLING=
